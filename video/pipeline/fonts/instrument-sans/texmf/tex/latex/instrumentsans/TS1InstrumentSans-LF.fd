}{}


%   ----  m = regular  ----

\DeclareFontShape{TS1}{InstrumentSans-LF}{m}{n}{
      <-> \InstrumentSans@@scale InstrumentSans-Regular-lf-ts1
}{}

\DeclareFontShape{TS1}{InstrumentSans-LF}{regular}{n}{
      <-> alias * InstrumentSans-LF/m/n
}{}


