        \space be\space aliased\MessageBreak to\space `\mandatory@arg'}%
}
\fi

\expandafter\ifx\csname InstrumentSans@scale\endcsname\relax
    \let\InstrumentSans@@scale\@empty
\else
    \edef\InstrumentSans@@scale{s*[\csname InstrumentSans@scale\endcsname]}%
\fi

\DeclareFontFamily{TS1}{InstrumentSans-LF}{}


%   ----  b = bold  ----

\DeclareFontShape{TS1}{InstrumentSans-LF}{b}{n}{
      <-> \InstrumentSans@@scale InstrumentSans-Bold-lf-ts1
}{}

\DeclareFontShape{TS1}{InstrumentSans-LF}{bold}{n}{
