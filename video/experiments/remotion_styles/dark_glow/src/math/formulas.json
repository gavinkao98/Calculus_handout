{
  "_comment": "TeX 源。\\class{tok-KEY}{...} 標記可定址的 token（MathTex 依 KEY 上色、MorphTex 依 KEY 配對）。改完跑 npm run tex 重新產 generated.ts。",
  "thm_sin": "\\class{tok-op}{\\frac{d}{dx}}\\,\\class{tok-sin}{\\sin x} \\class{tok-eq}{=} \\class{tok-cos}{\\cos x}",
  "thm_cos": "\\class{tok-op}{\\frac{d}{dx}}\\,\\class{tok-cos}{\\cos x} \\class{tok-eq}{=} \\class{tok-neg}{-}\\mkern-1.5mu\\class{tok-sin}{\\sin x}",
  "words": "\\class{tok-slope}{\\text{slope of}}\\;\\class{tok-sin}{\\sin}\\;\\class{tok-at1}{\\text{at}}\\;\\class{tok-x1}{x} \\class{tok-eq}{=} \\class{tok-height}{\\text{height of}}\\;\\class{tok-cos}{\\cos}\\;\\class{tok-at2}{\\text{at}}\\;\\class{tok-x2}{x}",
  "deriv": "\\class{tok-op}{\\frac{d}{dx}}\\,\\class{tok-sin}{\\sin}\\class{tok-x1}{x} \\class{tok-eq}{=} \\class{tok-cos}{\\cos}\\class{tok-x2}{x}",
  "y_sin": "\\class{tok-dim}{y=}\\class{tok-sin}{\\sin x}",
  "y_cos": "\\class{tok-dim}{y=}\\class{tok-cos}{\\cos x}",
  "tick_0": "0",
  "tick_pi2": "\\tfrac{\\pi}{2}",
  "tick_pi": "\\pi",
  "tick_mpi2": "-\\tfrac{\\pi}{2}",
  "tick_3pi2": "\\tfrac{3\\pi}{2}",
  "tick_1": "1",
  "tick_m1": "-1",
  "node_sin": "\\class{tok-sin}{\\sin x}",
  "node_cos": "\\class{tok-cos}{\\cos x}",
  "node_msin": "\\class{tok-neg}{-}\\mkern-1.5mu\\class{tok-sin}{\\sin x}",
  "node_mcos": "\\class{tok-neg}{-}\\mkern-1.5mu\\class{tok-cos}{\\cos x}",
  "ddx": "\\class{tok-op}{\\frac{d}{dx}}",
  "fourth": "\\class{tok-op}{\\frac{d^{4}}{dx^{4}}}\\,\\class{tok-sin}{\\sin x} \\class{tok-eq}{=} \\class{tok-sin}{\\sin x}"
}
